# LOCAL SYNTHETIC DEVELOPMENT ONLY. Do not deploy this file unchanged.
APP_NAME="CLSU MISO Service Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:5173
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clsu_feedback
DB_USERNAME=root
DB_PASSWORD=
# Non-local deployments override the two lines above with a dedicated MySQL user and a strong
# password (12+ characters). Startup rejects root/short credentials outside local/testing.
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
# HTTPS deployments must set SESSION_SECURE_COOKIE=true and SESSION_ENCRYPT=true.
QUEUE_CONNECTION=database
# Production must not use QUEUE_CONNECTION=sync: startup rejects it outside local/testing.
DEMO_SEED=false
MCP_ENABLED=false
# Local/testing allow admin setup by default. Hosting operators must opt in elsewhere.
# MCP_ADMIN_SETUP_ALLOWED=true
